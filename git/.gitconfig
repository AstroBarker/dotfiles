[core]
  editor = nvim
  pager = delta
[user]
  name = Brandon Barker
  email = bbarker.py@protonmail.ch

[pull]
  rebase = true

[rebase]
  autoStash = true

[alias]
    # Thanks r00k, this creates a pretty graph view of the log
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative

[push]
  default = current

[delta]
  line-numbers = true
  syntax-theme = gruvbox
  side-by-side = false

  file-modified-label = modified:

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between files
  light = false      # set to true if you use a light terminal theme
  side-by-side = true
