# shellcheck shell=bash
# Gruvbox-flavored prompt with virtualenv and git branch context.

get_virtual_env() {
  if [[ -n "$VIRTUAL_ENV" ]]; then
    basename "$(dirname "$VIRTUAL_ENV")" | sed 's/^/(/; s/$/) /'
  fi
}

AQUA="\[\033[38;2;104;157;106m\]"
BLUE="\[\033[38;2;69;133;136m\]"
YELLOW="\[\033[38;2;215;153;33m\]"
GREEN="\[\033[38;2;152;151;26m\]"
PURPLE="\[\033[38;2;143;63;113m\]"
RESET="\[\033[0m\]"

if [[ -r "$HOME/.git-prompt.sh" ]]; then
  # shellcheck source=/dev/null
  source "$HOME/.git-prompt.sh"
fi

set_prompt() {
  local git_branch=""

  if declare -F __git_ps1 >/dev/null; then
    git_branch="$(__git_ps1 " (%s)")"
  fi

  PS1="${BLUE}\$(get_virtual_env)${PURPLE}[${AQUA}\u@\h:${YELLOW}\W${PURPLE}]${GREEN}${git_branch}${RESET} $ "
}

PROMPT_COMMAND="history -a; history -n; set_prompt"
